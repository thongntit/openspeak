# OpenSpeak Environment Variables

# Database URL - for local testing use the local server
# VITE_DATABASE_URL=http://localhost:3001/words.json

# For production (GitHub raw URL) - uncomment and update with your username
# VITE_DATABASE_URL=https://raw.githubusercontent.com/YOUR_USERNAME/openspeak/main/database/words.json

# Azure Speech Service Configuration (required for pronunciation assessment)
# VITE_AZURE_SPEECH_KEY=your_azure_speech_key_here
# VITE_AZURE_SPEECH_REGION=your_azure_region_here
