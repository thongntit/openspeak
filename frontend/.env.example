# OpenSpeak Environment Variables

# Base URL for the OpenSpeak backend API (no trailing slash).
# Local dev: http://localhost:3000/api
# Production: https://<your-api-host>/api
VITE_OPENSPEAK_API_URL=http://localhost:3000/api

# Word database URL (IndexedDB sync source)
# Local testing: http://localhost:3001/words.json
# Production (GitHub raw): https://raw.githubusercontent.com/YOUR_USERNAME/openspeak/main/database/words.json
# VITE_DATABASE_URL=http://localhost:3001/words.json

# Azure Speech Service (required for pronunciation assessment)
# VITE_AZURE_SPEECH_KEY=your_azure_speech_key_here
# VITE_AZURE_SPEECH_REGION=your_azure_region_here
