PORT=3001

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Static password for login
AUTH_PASSWORD=

# Secret for signing JWTs — generate with: openssl rand -hex 32
JWT_SECRET=

# ─── Azure Speech ─────────────────────────────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_REGION=eastus

# ─── Quota ────────────────────────────────────────────────────────────────────
DAILY_LIMIT=15

# ─── Frontend static files (relative to backend directory) ───────────────────
FRONTEND_DIST=../frontend/dist
